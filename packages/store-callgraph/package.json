{
  "name": "store-callgraph",
  "version": "0.0.0",
  "description": "Static call graphs of an Angular feature built on NgRx SignalStore, diffed between a pull request and its base.",
  "license": "MIT",
  "author": "Tom Stapleton <tstapleton@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "store-callgraph": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "lint": "biome check",
    "format": "biome check --write",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm pack --dry-run --silent",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@angular/compiler": ">=20",
    "typescript": ">=5.8 <6"
  },
  "dependencies": {
    "pele": "1.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@angular/compiler": "20.3.34",
    "@angular/core": "20.3.34",
    "@biomejs/biome": "2.5.15",
    "@ngrx/signals": "20.1.0",
    "@types/node": "22.20.5",
    "rxjs": "7.8.2",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
